      "id": "4d4d4d4d-0002-0002-0002-000000000002",
      "name": "Get All Shipments",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst counts = {};\n\nfor (const item of items) {\n  const customerId = item.json.customer_id;\n  if (!customerId) continue;\n  counts[customerId] = (counts[customerId] || 0) + 1;\n}\n\nconst result = [];\nfor (const [customerId, count] of Object.entries(counts)) {\n  result.push({\n    json: {\n      customer_id: customerId,\n      shipment_count: count,\n      segment: count > 2 ? 'repeat' : 'new'\n    }\n  });\n}\n\nreturn result;"
      },
      "id": "4d4d4d4d-0003-0003-0003-000000000003",
      "name": "Count Shipments Per Customer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.segment }}",
              "rightValue": "repeat",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
